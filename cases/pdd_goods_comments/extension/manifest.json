{
  "manifest_version": 3,
  "name": "PDD Comments RPC Bridge",
  "version": "0.1.0",
  "description": "WS bridge: MAIN-world webpack 45246.g() + native fetch → local Python. No CDP, no native hooks.",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "alarms",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://mobile.pinduoduo.com/*",
    "https://*.pinduoduo.com/*",
    "https://*.yangkeduo.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://mobile.pinduoduo.com/*",
        "https://*.pinduoduo.com/*",
        "https://*.yangkeduo.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "PDD RPC Bridge"
  }
}
